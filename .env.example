# ==============================================================================
# whenvanshwrites Environment Variables Configuration (.env.example)
# Copy this file to .env.local for local development.
# On Vercel, set these in: Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Connection (Project Settings -> API)
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public anon key (Safe for browser / client components)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secret service role key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER / GIT)
# Used for backend database queries and storage bucket administration.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. Portfolio Owner Studio Authorization (/adminvansh)
# ------------------------------------------------------------------------------
# Verified Supabase User ID (UUID) of the owner account.
# Find this in Supabase Dashboard -> Authentication -> Users after signing up.
SUPABASE_OWNER_USER_ID="00000000-0000-0000-0000-000000000000"

# Owner email address for verification & notifications
SUPABASE_OWNER_EMAIL="vanshbhati522@gmail.com"

# ------------------------------------------------------------------------------
# 3. Canonical Domain & Production URLs
# ------------------------------------------------------------------------------
# Site public URL (used for metadata, open graph, and auth callbacks)
# Initially your Vercel address: https://your-project.vercel.app
# After is-a.dev connects: https://whenvanshwrites.is-a.dev
NEXT_PUBLIC_SITE_URL="https://whenvanshwrites.is-a.dev"
